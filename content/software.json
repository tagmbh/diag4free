  "install": {
    "steps": [
      "USB-Stick als FAT32 formatieren.",
      "Die .bin-Datei in das Wurzelverzeichnis des Sticks kopieren (nicht in einen Ordner).",
      "Stick in den USB-Port in der Mittelarmlehne stecken.",
      "Im Fahrzeug: Einstellungen → Software-Update → Update starten.",
      "Motor laufen lassen. Stick erst nach Abschluss entfernen.",
      "Nach Abschluss zeigt das Fahrzeug die neue Version. Playlists ggf. neu wählen."
    ],
    "notes": [
      "Wird das Update als „zu alt“ abgelehnt: Fahrzeugdatum im iDrive mehrere Jahre zurückstellen, dann Fahrzeug abschließen und 10–15 Minuten stehen lassen — die Combox braucht diese Zeit zum Resync, Datum allein reicht nicht.",
      "Zeigt Bluetooth-Media nach dem Update falsche Metadaten: prüfen, ob der Bluetooth-Gerätename des Telefons Emojis enthält — das kann die Titel/Interpret-Anzeige brechen."
    ]
  },
  "diagnostic": [
    {
      "name": "INPA + EDIABAS",
      "version": "INPA 5.0.6 · EDIABAS 7.3.0",
      "target": "Alle E-Serien (K-Line + D-CAN), Basisdiagnose & Statusblöcke",
      "note": "Teil der „BMW Standard Tools“. Für E88: D-CAN-Modus, FTDI-Kabel.",
      "bezug": "Ersetzt fuer Antriebsdiagnose durch den eigenen OBD-Scan: Fehlerspeicher, Live-Werte und VIN laufen ohne dieses Werkzeug. Fuer Komfort- und Karosseriesteuergeraete bleibt es noetig."
